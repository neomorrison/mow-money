{
  "name": "mow-money",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mow Money: a lawn care empire game. Start with a push reel mower, knock on doors, haggle, mow, hire crews, build an empire.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "tsx tools/balance.ts",
    "snap": "node tools/snap.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
